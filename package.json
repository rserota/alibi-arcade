{
  "name": "fullstack-app",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm --workspace server run dev\" \"npm --workspace client run dev\"",
    "build": "npm --workspaces run build",
    "start": "node server/dist/index.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
